{
  "buildCommand": "node tests/verify-gutter-page.cjs && unzip -q ellis-services-group-site.zip -d dist && find . -maxdepth 1 -type f ! -name 'ellis-services-group-site.zip' -exec cp {} dist/ \\; && cp -R assets api dist/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "permanent": true,
      "destination": "/"
    },
    {
      "source": "/roof-repairs-burnside.html",
      "permanent": true,
      "destination": "/roof-repairs-burnside-adelaide.html"
    },
    {
      "source": "/roof-repairs-campbelltown.html",
      "permanent": true,
      "destination": "/roof-repairs-campbelltown-adelaide.html"
    },
    {
      "source": "/roof-repairs-glen-osmond.html",
      "permanent": true,
      "destination": "/roof-repairs-glen-osmond-adelaide.html"
    },
    {
      "source": "/roof-repairs-glenelg.html",
      "permanent": true,
      "destination": "/roof-repairs-glenelg-adelaide.html"
    },
    {
      "source": "/roof-repairs-goodwood.html",
      "permanent": true,
      "destination": "/roof-repairs-goodwood-adelaide.html"
    },
    {
      "source": "/roof-repairs-henley-beach.html",
      "permanent": true,
      "destination": "/roof-repairs-henley-beach-adelaide.html"
    },
    {
      "source": "/roof-repairs-kensington.html",
      "permanent": true,
      "destination": "/roof-repairs-kensington-adelaide.html"
    },
    {
      "source": "/roof-repairs-modbury.html",
      "permanent": true,
